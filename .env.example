# AI 诊断 Provider：mock（默认，预生成校验结果） | live（真实大模型）
AML_AI_PROVIDER=mock

# 只读模式：默认开（fail-closed）。直启 python3 backend/main.py（容器/托管平台）
# 与本文件均默认只读；本机可写演示用 ./run.sh（其内部默认 QINGYUAN_READ_ONLY=0 + 127.0.0.1）。
# 只读模式下所有写接口 403、审计链保持不可变（校验与查询接口仍开放）。
# QINGYUAN_READ_ONLY=1

# 监听地址：默认 0.0.0.0（适配容器/托管平台，平台只注入 PORT）。
# 本机演示想仅监听本机时：QINGYUAN_HOST=127.0.0.1（run.sh 已默认如此）。
# QINGYUAN_HOST=0.0.0.0

# CORS 跨域白名单：默认同源（不配置则跨域请求被浏览器拦截）。
# 确需跨域访问时填逗号分隔的来源，如 https://example.com,http://127.0.0.1:3000
# QINGYUAN_CORS_ORIGINS=

# 接口限流（单 worker 内存滑窗，按 IP）：每分钟 /api 总量与写请求量，0 = 关闭。
# 生产部署建议由 API 网关/反向代理层承担限流。
# QINGYUAN_RATE_LIMIT=240
# QINGYUAN_RATE_LIMIT_POST=60

# Live 模式配置（OpenAI 兼容格式，DeepSeek 等通用）
# DeepSeek 为按 token 计费、充值即用（无月费）：platform.deepseek.com 充值 10-20 元
# 即可跑完整个演示。输出会经过结构校验（字段/枚举/长度），不合格自动重试一次，
# 仍失败则明确报错，不会把模型异常输出写进报告链路。
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AML_MODEL=deepseek-chat

# CDD 外部数据源（客户尽职调查）
# 企查查开放平台 Key（按次计费：基础工商约 1 元/次，综合风险接口最高约 6 元/次）。
# 未配置时 CDD 页显示"未接入"，不会用模拟结果冒充真实核查。
# QCC_API_KEY=your-qcc-key
